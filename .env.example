# Server only. Fill secrets locally; never commit a populated .env.
# Values below were generated, not copied from the source environment.
DEBTOFF_DEMO_MODE=0
DEBTOFF_DATA_DIR=.local
DEBTOFF_CORPUS_DIR=.local/corpus
DEBTOFF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
DEBTOFF_MODEL_PROVIDER=ollama
DEBTOFF_AUTO_AX=1
# Optional; keep unset to use application defaults: DEBTOFF_OCR_MAX_PAGES=
# Optional; keep unset to use application defaults: DEBTOFF_OCR_TIMEOUT=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEBTOFF_USE_REFERENCE_CREDENTIALS=0
# Optional; keep unset to use application defaults: LAW_API_OC=
# Optional; keep unset to use application defaults: DEBTOFF_STAFF_LOGIN=
DEBTOFF_STAFF_PASSWORD=
# Optional; keep unset to use application defaults: DEBTOFF_LAWYER_LOGIN=
DEBTOFF_LAWYER_PASSWORD=
DEBTOFF_START_PROFILE=fresh
DEBTOFF_LEGAL_WATCH=0
DEBTOFF_API_ORIGIN=http://localhost:8000
PORT=8000
